# 图片 API 总开关
IMAGE_API_PROVIDER=minimax
IMAGE_API_DRY_RUN=true

# 智谱 AI / ZhipuAI
ZHIPUAI_API_KEY=
ZHIPUAI_IMAGE_MODEL=

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# resolved candidate model: image-01
MINIMAX_IMAGE_MODEL=

# 阶跃星辰 / StepFun
STEPFUN_API_KEY=
STEPFUN_IMAGE_MODEL=

# 贴纸候选输出
STICKER_CANDIDATE_OUTPUT_DIR=tmp/api贴纸候选_api_sticker_candidates
STICKER_REQUIRE_TRANSPARENT_BACKGROUND=true
STICKER_ALLOW_BACKGROUND_REMOVAL=true

# 图片输出质量策略
IMAGE_REQUIRE_NO_WATERMARK=true
IMAGE_REQUIRE_NO_GENERATED_LABEL=true
IMAGE_REQUIRE_NO_LOGO=true
IMAGE_REQUIRE_NO_BRAND_MARK=true
IMAGE_WATERMARKED_OUTPUT_ACTION=reject_candidate
IMAGE_GENERATED_LABEL_OUTPUT_ACTION=reject_candidate
IMAGE_DO_NOT_REMOVE_WATERMARK=true

# Provider 路由策略
IMAGE_PROVIDER_ROUTE_MODE=watermark_free_required
ZHIPUAI_ALLOWED_FOR_STICKER_CANDIDATE=false
ZHIPUAI_ALLOWED_FOR_CONNECTION_TEST=true
NEXT_IMAGE_PROVIDER_REQUIRED_FEATURES=no_watermark,no_generated_label,transparent_or_clean_background

# 安全限制
ALLOW_IMAGE_API_CALL=false
ALLOW_STICKER_ASSET_GENERATION=false
ALLOW_REMOTION_EDIT=false
ALLOW_RENDER=false
